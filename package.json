{
  "name": "dsh-pet-statuslight",
  "version": "1.0.34",
  "description": "DeepSeek Harness status-light plugin: character expressions follow the model state, chat-bubble notifications, and a Windows always-on-top mini-window. 状态灯插件：角色表情跟随模型状态 + 聊天框气泡 + 系统级置顶小窗。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "scripts": {
    "prepack": "node -e \"const fs=require('fs');['lib/index.js','client/client.js','cordis.patch.yml','package.json'].forEach(f=>{if(!fs.existsSync(f)){console.error('missing '+f);process.exit(1)}});console.log('prepack ok')\""
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "assets/characters/*/action/**",
    "assets/characters/*/聊天框/**",
    "assets/screenshots/**",
    "docs",
    "INSTALL.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "status-light",
    "cordis",
    "desktop-widget",
    "pet"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongchengavg/dsh-pet-StatusLight.git"
  },
  "homepage": "https://github.com/kongchengavg/dsh-pet-StatusLight"
}
